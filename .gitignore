# Data (download separately - 4D-OR dataset)
data/*
!data/.gitkeep

# Checkpoints and weights (download separately)
checkpoints/*
!checkpoints/.gitkeep
weights/*
!weights/.gitkeep
!weights/dinov3/
weights/dinov3/*
!weights/dinov3/.gitkeep

# Caches (generated or downloaded)
caches/*
!caches/.gitkeep

# Outputs (generated during training/eval)
outputs/*
!outputs/.gitkeep

# Processed data (generated by manifest_generation.py)
processed_data/*
!processed_data/.gitkeep

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
dist/
build/

# Jupyter
.ipynb_checkpoints/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
wandb/
